# ==========================================
# FleetReloc Environment Configuration Template
# ==========================================

# --- Application Settings ---
APP_ENV=local
DEBUG=true
PORT=8000

# --- Database (PostgreSQL / Supabase Async) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fleetreloc

# --- Redis (For FCFS Concurrency & Ephemeral Sessions) ---
REDIS_URL=redis://localhost:6379/0

# --- OCR & LLM Parsing (On-Premise Ollama) ---
# Local Ollama instance only -- manifest content never leaves the perimeter
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT_SECONDS=120
OCR_LANGUAGES=eng+deu+ara
OCR_FALLBACK_LANGUAGE=eng

# --- Routing (OSRM default; see README "Routing & Geolocation") ---
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
# OSRM_BASE_URL=http://osrm-backend:5000/route/v1/driving

# --- Multi-Channel Notifications (Strategy / Factory Pattern) ---
# Options: 'telegram' (for R&D/MVP) or 'bird_whatsapp' (for GCC Production)
NOTIFICATION_CHANNEL=telegram

# Telegram Bot Integration (MVP & Local R&D)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_default_test_chat_id_here

# Bird / WhatsApp Business API Integration (GCC Production - Optional for Public R&D)
BIRD_ACCESS_KEY=your_bird_access_key_here
BIRD_BASE_URL=https://api.bird.com
BIRD_WHATSAPP_CHANNEL_ID=your_bird_channel_id_here
BIRD_TEMPLATE_NAME=order_offer_v1
